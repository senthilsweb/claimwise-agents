# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Model (Amazon Bedrock) ---
AWS_REGION=us-east-2
AWS_PROFILE=default
# Only needed if you prefer keys over a named profile — boto3 picks these up
# automatically if set. Leave blank to use AWS_PROFILE / the default chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Pick from `aws bedrock list-foundation-models` (a Claude model id) — set once
# Bedrock model access is granted in the console (Bedrock > Model catalog).
BEDROCK_MODEL_ID=

# --- Data target: duckdb (dev, zero infra) | databricks (prod) ---
AGENT_TARGET=duckdb

# DuckDB dev: the file built by the claimwise repo (make setup deps build there)
DUCKDB_PATH=/path/to/claimwise/dbt-pipeline/rcm.duckdb

# The claimwise dbt-pipeline repo root — Data Steward only (run_dq_checks
# runs `dbt test` there; get_lineage reads its target/manifest.json).
CLAIMWISE_DBT_PATH=/path/to/claimwise/dbt-pipeline

# Databricks prod (read-only credentials — agents never write)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace

# --- Observability (both optional — absence just disables tracing) ---
# Full prompts, tool inputs, and tool outputs are captured by default —
# Strands' tracer only redacts them if you explicitly opt into that via
# OTEL_SEMCONV_STABILITY_OPT_IN (see agents/telemetry.py).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claimwise-agents

ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=claimwise-agents

# Any generic OTLP/HTTP collector (e.g. a home-lab OpenObserve instance).
# OTEL_EXPORTER_OTLP_ENDPOINT accepts either an org/stream base URL
# (…/api/default) or a full …/v1/traces URL — both get normalized.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- AgentCore Memory (optional — blank MEMORY_ID disables it entirely) ---
# Needs a Memory resource created once via MemoryClient.create_memory_and_wait(...),
# which needs bedrock-agentcore:CreateMemory permission. Untested in this repo
# so far — see tasks.md B4.4.
MEMORY_ID=
MEMORY_ACTOR_ID=demo-user
