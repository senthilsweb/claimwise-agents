# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Model (Amazon Bedrock) ---
AWS_REGION=us-east-2
AWS_PROFILE=default
# Only needed if you prefer keys over a named profile — boto3 picks these up
# automatically if set. Leave blank to use AWS_PROFILE / the default chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Pick from `aws bedrock list-foundation-models` (a Claude model id) — set once
# Bedrock model access is granted in the console (Bedrock > Model catalog).
BEDROCK_MODEL_ID=

# --- Data target: duckdb (dev, zero infra) | databricks (prod) ---
AGENT_TARGET=duckdb

# DuckDB dev: the file built by the claimwise repo (make setup deps build there)
DUCKDB_PATH=/path/to/claimwise/dbt-pipeline/rcm.duckdb

# Databricks prod (read-only credentials — agents never write)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
